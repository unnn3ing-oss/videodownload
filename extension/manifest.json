{
  "manifest_version": 3,
  "name": "YouTube 批量下載器",
  "version": "0.1.0",
  "description": "在本機批量下載公司 YouTube 頻道的公開影片（720p / 1080p）",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube 批量下載器"
  }
}
