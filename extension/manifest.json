{
  "manifest_version": 3,
  "name": "YouTube 批量下載器",
  "version": "0.5.1",
  "description": "在本機批量下載公司 YouTube 頻道的公開影片（720p / 1080p）",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "storage",
    "sidePanel",
    "alarms",
    "scripting",
    "clipboardWrite"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https://i.ytimg.com; connect-src 'self' https://api.github.com https://raw.githubusercontent.com https://i.ytimg.com; base-uri 'none'; form-action 'none'; object-src 'none'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "YouTube 批量下載器",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*",
    "https://youtu.be/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://i.ytimg.com/*",
    "https://unnn3ing-oss.github.io/videodownload/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://unnn3ing-oss.github.io/videodownload/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
