# Line endings are decided here, not by each person's git settings (Windows checkouts included).
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Generated by build.py and compared byte for byte (the .cmd is CRLF by design, the zip is binary): never convert or diff as text.
extension/installers/* -text -diff

*.zip binary
*.png binary
*.jpg binary
